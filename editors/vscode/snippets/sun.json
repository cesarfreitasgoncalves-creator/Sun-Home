{
  "Function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2})${3:: number}",
      "    $0",
      "end"
    ],
    "description": "Declare a Sun function"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}:",
      "    ${2}",
      "else:",
      "    $0",
      "end"
    ],
    "description": "Conditional block with else"
  },
  "For range": {
    "prefix": "for",
    "body": [
      "for ${1:item} in range(${2:0}, ${3:10}):",
      "    $0",
      "end"
    ],
    "description": "Iterate over a numeric range"
  },
  "For each": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    $0",
      "end"
    ],
    "description": "Iterate over a list or dictionary"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    $0",
      "end"
    ],
    "description": "While loop"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "    $0",
      "end"
    ],
    "description": "Declare a class"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "    ${2:field}: ${3:string}",
      "end"
    ],
    "description": "Declare a struct"
  },
  "Try / except": {
    "prefix": "try",
    "body": [
      "try:",
      "    ${1}",
      "except AnError as ${2:error}:",
      "    $0",
      "end"
    ],
    "description": "Catch a Sun runtime error"
  },
  "Try / finally": {
    "prefix": "tryfinally",
    "body": [
      "try:",
      "    ${1}",
      "finally:",
      "    $0",
      "end"
    ],
    "description": "Run cleanup after a try block"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    case ${2:pattern}:",
      "        $0",
      "end"
    ],
    "description": "Match a value or enum variant"
  },
  "Formatted string": {
    "prefix": "fstr",
    "body": [
      "f\"${1:value}\"$0"
    ],
    "description": "Create a formatted string"
  },
  "Inline C++": {
    "prefix": "inlinecpp",
    "body": [
      "inline cpp:",
      "    $0",
      "endcpp"
    ],
    "description": "Insert a native C++ block"
  },
  "Variadic parameters": {
    "prefix": "varargs",
    "body": [
      "def ${1:function}(*${2:values}: ${3:int}, **${4:options}: ${5:string})",
      "    $0",
      "end"
    ],
    "description": "Declare typed *args and **kwargs parameters"
  }
}
